/*Q71. Read and print a matrix.*/
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int a[100][100];

    scanf("%d %d", &rows, &cols);

    // Read matrix elements
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Print matrix
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("%d ", a[i][j]);
        }
        printf("\n");
    }

    return 0;
}

/*Q72. Find the sum of all elements in a matrix.*/
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int a[100][100];
    int sum = 0;

    scanf("%d %d", &rows, &cols);

    // Read matrix and calculate sum
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
            sum = sum + a[i][j];
        }
    }

    printf("%d", sum);

    return 0;
}
