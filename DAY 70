/*Q 120. Write a program to take a string input. Change it to sentence case.*/

#include <stdio.h>
#include <ctype.h>

int main() {
    char str[500];
    int i;

    fgets(str, sizeof(str), stdin);

    int newWord = 1;

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ' || str[i] == '\t') {
            newWord = 1;
        } else if (str[i] == '\n') {
            str[i] = '\0';
            break;
        } else {
            if (newWord) {
                str[i] = toupper((unsigned char)str[i]);
                newWord = 0;
            } else {
                str[i] = tolower((unsigned char)str[i]);
            }
        }
    }

    printf("%s\n", str);

    return 0;
}
