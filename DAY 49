/*Q97.Print the initials of a name.*/
#include <stdio.h>
int main() {
    char str[200];
    int i = 0, start = 1;

    fgets(str, sizeof(str), stdin);

    while (str[i] != '\0' && str[i] != '\n') {
        if (str[i] != ' ' && start) {
            printf("%c", str[i]);
            start = 0;
        }

        if (str[i] == ' ')
            start = 1;

        i++;
    }

    return 0;
}

/*Q98.Print initials of a name with the surname displayed in full.*/
#include <stdio.h>

int main() {
    char str[200], words[50][50];
    int i = 0, j = 0, k = 0, count = 0;

    fgets(str, sizeof(str), stdin);

    while (1) {
        if (str[i] != ' ' && str[i] != '\n' &&
            str[i] != '\0') {
            words[count][j++] = str[i];
        } else if (j > 0) {
            words[count][j] = '\0';
            count++;
            j = 0;
        }

        if (str[i] == '\0' || str[i] == '\n')
            break;

        i++;
    }

    if (count > 0) {
        for (i = 0; i < count - 1; i++)
            printf("%c. ", words[i][0]);

        printf("%s", words[count - 1]);
    }

    return 0;
}
