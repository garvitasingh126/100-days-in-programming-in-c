/*Q108.Write a Program to take an integer array nums. Print an array answer such that answer[i] is equal 
to the product of all the elements of nums except nums[i]. The product of any prefix or suffix of nums is
guaranteed to fit in a 32-bit integer. */

#include <stdio.h>
int main() {
    int n, a[1000], ans[1000], i;
    int prefix = 1, suffix = 1;

    scanf("%d", &n);
    for (i = 0; i < n; i++) scanf("%d", &a[i]);

    for (i = 0; i < n; i++) {
        ans[i] = prefix;
        prefix *= a[i];
    }

    for (i = n - 1; i >= 0; i--) {
        ans[i] *= suffix;
        suffix *= a[i];
    }

    for (i = 0; i < n; i++)
        printf("%d ", ans[i]);

    return 0;
}
