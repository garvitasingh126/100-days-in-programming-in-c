/*Q112.Write a program to take an integer array arr as input. The task is to find the maximum sum of any 
contiguous subarray using Kadane's algorithm. Print the maximum sum as output. If all elements are negative,
print the largest (least negative) element.*/

#include <stdio.h>
int main() {
    int n, a[1000], i;
    int current, maxSum;

    scanf("%d", &n);
    if (n <= 0) return 0;

    for (i = 0; i < n; i++) scanf("%d", &a[i]);

    current = maxSum = a[0];

    for (i = 1; i < n; i++) {
        if (current + a[i] < a[i])
            current = a[i];
        else
            current += a[i];

        if (current > maxSum)
            maxSum = current;
    }

    printf("%d", maxSum);
    return 0;
}
