/*Write a program to print all factors of a given number.*/
#include <stdio.h>
int main() {
    int n, i;

    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        if (n % i == 0) {
            printf("%d ", i);
        }
    }

    return 0;
}

/*Write a program to find the HCF (GCD) of two numbers.*/
#include <stdio.h>
int main() {
    int a, b, hcf;

    scanf("%d %d", &a, &b);

    while (b != 0) {
        hcf = a % b;
        a = b;
        b = hcf;
    }

    printf("%d", a);

    return 0;
}
