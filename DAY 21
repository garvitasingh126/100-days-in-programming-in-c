/*Q41. Write a program to swap the first and last digit of a number.*/
#include<stdio.h>
int main ()
{ int n, first, last, digits = 0;
    int temp, power, middle, result;

    scanf("%d", &n);

    temp = n;

    /* Find last digit */
    last = n % 10;

    /* Find number of digits */
    while (temp >= 10) {
        temp = temp / 10;
        digits++;
    }

    first = temp;

    /* For single digit numbers */
    if (digits == 0) {
        printf("%d", n);
        return 0;
    }

    /* Power of 10 corresponding to first digit */
    power = 1;
    for (int i = 1; i <= digits; i++) {
        power = power * 10;
    }

    /* Remove first and last digit */
    middle = (n % power) / 10;

    /* Swap first and last digits */
    result = last * power + middle * 10 + first;

    printf("%d", result);

    return 0;
}

/*Q42. Write a program to check if a number is a perfect number.*/
#include<stdio.h>
int main ()
 {
    int n, i, sum = 0;

    scanf("%d", &n);

    for (i = 1; i < n; i++) {
        if (n % i == 0) {
            sum = sum + i;
        }
    }

    if (sum == n)
        printf("Perfect Number");
    else
        printf("Not a Perfect Number");

    return 0;
}
