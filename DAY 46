/*Q91.Remove all vowels from a string.*/
#include <stdio.h>

int main() {
    char str[200];
    int i = 0, j = 0;

    fgets(str, sizeof(str), stdin);

    while (str[i] != '\0' && str[i] != '\n') {
        char ch = str[i];

        if (ch != 'a' && ch != 'e' && ch != 'i' &&
            ch != 'o' && ch != 'u' && ch != 'A' &&
            ch != 'E' && ch != 'I' && ch != 'O' &&
            ch != 'U') {
            str[j] = str[i];
            j++;
        }

        i++;
    }

    str[j] = '\0';

    printf("%s", str);

    return 0;
}

/*Q92.Find the first repeating lowercase alphabet in a string.*/
#include <stdio.h>
int main() {
    char str[200];
    int freq[26] = {0};
    int i = 0, found = 0;

    fgets(str, sizeof(str), stdin);

    while (str[i] != '\0' && str[i] != '\n') {
        if (str[i] >= 'a' && str[i] <= 'z') {
            int index = str[i] - 'a';

            if (freq[index] == 1) {
                printf("%c", str[i]);
                found = 1;
                break;
            }

            freq[index]++;
        }

        i++;
    }

    if (found == 0) {
        printf("-1");
    }

    return 0;
}
