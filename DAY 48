/*Q95.Check if one string is a rotation of another.*/
#include <stdio.h>
int main() {
    char a[200], b[200];
    int i, j, n = 0, m = 0, found = 0;

    scanf("%199s %199s", a, b);

    while (a[n] != '\0') n++;
    while (b[m] != '\0') m++;

    if (n != m) {
        printf("Not Rotation");
        return 0;
    }

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (a[(i + j) % n] != b[j])
                break;
        }

        if (j == n) {
            found = 1;
            break;
        }
    }

    printf("%s", found ? "Rotation" : "Not Rotation");
    return 0;
}
/*Q96.Reverse each word in a sentence without changing the word order.*/

#include <stdio.h>
int main() {
    char str[500];
    int i = 0, start = 0, j;
    char temp;

    fgets(str, sizeof(str), stdin);

    while (1) {
        if (str[i] == ' ' || str[i] == '\n' ||
            str[i] == '\0') {
            j = i - 1;

            while (start < j) {
                temp = str[start];
                str[start] = str[j];
                str[j] = temp;
                start++;
                j--;
            }

            start = i + 1;

            if (str[i] == '\n' || str[i] == '\0')
                break;
        }
        i++;
    }

    printf("%s", str);
    return 0;
}
