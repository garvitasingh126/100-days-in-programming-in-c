/*Q65. Search in a sorted array using binary search.*/
#include <stdio.h>

int main()
{
    int a[100], n, key;
    int low, high, mid;
    int i, found = 0;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = low + (high - low) / 2;

        if(a[mid] == key)
        {
            printf("Found at index %d", mid);
            found = 1;
            break;
        }
        else if(a[mid] < key)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    if(found == 0)
    {
        printf("-1");
    }

    return 0;
}

/*Q66. Insert an element in a sorted array at the appropriate position.*/
#include <stdio.h>

int main()
{
    int a[100], n, x;
    int i, pos;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    scanf("%d", &x);

    pos = 0;

    while(pos < n && a[pos] < x)
    {
        pos++;
    }

    for(i = n; i > pos; i--)
    {
        a[i] = a[i - 1];
    }

    a[pos] = x;
    n++;

    for(i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }

    return 0;
}
