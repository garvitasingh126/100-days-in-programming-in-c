/*Q69. Find the second largest element in an array.*/
#include <stdio.h>
#include <limits.h>

int main() {
    int n, i;
    int a[100];
    int largest = INT_MIN;
    int secondLargest = INT_MIN;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);

        if (a[i] > largest) {
            secondLargest = largest;
            largest = a[i];
        } 
        else if (a[i] > secondLargest && a[i] != largest) {
            secondLargest = a[i];
        }
    }

    printf("%d", secondLargest);

    return 0;
}

/*Q70. Rotate an array to the right by k positions.*/

#include <stdio.h>

int main() {
    int n, k, i, j, temp;
    int a[100];

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &k);

    k = k % n;

    // Rotate the array right by k positions
    for (i = 0; i < k; i++) {
        temp = a[n - 1];

        for (j = n - 1; j > 0; j--) {
            a[j] = a[j - 1];
        }

        a[0] = temp;
    }

    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}
