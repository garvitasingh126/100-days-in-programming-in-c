/*Q73. Find the sum of each row of a matrix and store it in an array.*/
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int a[100][100];
    int rowSum[100];

    scanf("%d %d", &rows, &cols);

    // Read matrix and calculate each row's sum
    for (i = 0; i < rows; i++) {
        rowSum[i] = 0;

        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
            rowSum[i] = rowSum[i] + a[i][j];
        }
    }

    for (i = 0; i < rows; i++) {
        printf("%d ", rowSum[i]);
    }

    return 0;
}

/*Q74. Find the transpose of a matrix.*/
#include <stdio.h>

int main() {
    int rows, cols, i, j;
    int a[100][100];
    int transpose[100][100];

    scanf("%d %d", &rows, &cols);
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            transpose[j][i] = a[i][j];
        }
    }

    for (i = 0; i < cols; i++) {
        for (j = 0; j < rows; j++) {
            printf("%d ", transpose[i][j]);
        }
        printf("\n");
    }

    return 0;
}
