/*Q67. Insert an element in an array at a given position.*/
#include <stdio.h>

int main() {
    int n, i, pos, element;
    int a[100];

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &pos);
    scanf("%d", &element);

    // Shift elements to the right
    for (i = n; i >= pos; i--) {
        a[i] = a[i - 1];
    }

    a[pos - 1] = element;
    n++;

    // Print updated array
    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}

/*Q68. Delete an element from an array.*/
#include <stdio.h>

int main() {
    int n, i, pos;
    int a[100];

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &pos);

    // Shift elements to the left
    for (i = pos - 1; i < n - 1; i++) {
        a[i] = a[i + 1];
    }

    n--;

    // Print updated array
    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}
